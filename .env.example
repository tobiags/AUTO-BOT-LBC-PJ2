# ── DATABASE ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://autotransfert:password@localhost:5432/autotransfert_p2
CONTROL_TOWER_TOKEN=
CONTROL_TOWER_SESSION_SECRET=
CONTROL_TOWER_ADMIN_USER=admin
CONTROL_TOWER_ADMIN_PASSWORD=
BROWSER_USE_TASK_COST_LIMIT=2.0
BROWSER_USE_POLL_INTERVAL_SECONDS=5
BROWSER_USE_TASK_TIMEOUT_SECONDS=900
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
CAMOUFOX_ENABLED=false
OBSCURA_ENABLED=false
LAB_SERVICE_URL=http://experimental_lab:8010
LAB_API_TOKEN=
LAB_ALLOWED_DOMAINS=leboncoin.fr,www.leboncoin.fr

# ── REDIS / CELERY ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── HETZNER ───────────────────────────────────────────────────────────
# (info server — utilisé dans scripts de déploiement)
VPS_IP=

# ── SMSTOOLS ─────────────────────────────────────────────────────────
SMSTOOLS_API_KEY=
SMSTOOLS_WEBHOOK_SECRET=

# ── IPROXY.ONLINE ─────────────────────────────────────────────────────
IPROXY_API_KEY=
IPROXY_CONNECTION_ID=
IPROXY_PROXY_ID=

# ── SMSAPP.IO (OTP jetables) ─────────────────────────────────────────
SMSAPP_API_TOKEN=

# ── MAILGUN ───────────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=
OPERATIONAL_DOMAIN=

# ── SENTRY ────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── BROWSER-USE CLOUD (Mode B fallback) ───────────────────────────────
BROWSER_USE_API_KEY=

# ── PATCHRIGHT ────────────────────────────────────────────────────────
# Répertoire des profils de session (persistance cookies DataDome)
SESSIONS_DIR=runtime/modules/patchright/sessions
PATCHRIGHT_CHANNEL=chrome
PATCHRIGHT_HEADLESS=true
PATCHRIGHT_NO_VIEWPORT=true

# ── APP ───────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=change-me-in-production
ADMIN_HEALTH_TOKEN=
STRICT_STARTUP_VALIDATION=false
HEALTHCHECK_TIMEOUT_SECONDS=5
# Fenêtre horaire SMS (heure de Paris)
SMS_HOUR_START=8
SMS_HOUR_END=20
SMS_STOP_NUMBER=XXXX
# Pool comptes LBC — minimum à maintenir
LBC_ACCOUNTS_MIN_ACTIVE=3
